{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ascent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3020
    },
    {
      "name": "ascent-movil",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8090"],
      "cwd": "movil",
      "port": 8090,
      "env": { "EXPO_PUBLIC_DIAGNOSTICO": "1" }
    }
  ]
}
