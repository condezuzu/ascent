# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Dashboard de Supabase -> Settings -> API)
# Estas dos son las únicas que necesita la app, y son también las únicas
# que hay que cargar en Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo para `npm run test:e2e` en local. NO va en Vercel.
# Una casilla real tuya: las cuentas de prueba se crean como vos+algo@dominio
E2E_EMAIL=
