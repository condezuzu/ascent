{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Los archivos de `nucleo/` se importan entre sí CON extensión: `test:db`
    // los carga con node pelado, y ESM sin extensión no resuelve.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nucleo/*": [
        "./nucleo/*"
      ],
      // LO COMPARTIDO CON LA APP NATIVA: la sesión, la cola, el descanso. Usa
      // React y la plataforma, así que no es núcleo; y lo usan las dos apps,
      // así que no es de ninguna. Cada app le dice qué es `@plataforma` y
      // `@cliente` (acá, la web; en `movil/`, la nativa).
      "@compartido/*": [
        "./compartido/*"
      ],
      "@plataforma": [
        "./src/plataforma/index.ts"
      ],
      "@cliente": [
        "./src/lib/supabase/client.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-arranque/types/**/*.ts",
    ".next-capturas/types/**/*.ts",
    ".next-exif/types/**/*.ts",
    ".next-medir/types/**/*.ts",
    ".next-pantallas/types/**/*.ts",
    ".next-primera/types/**/*.ts",
    ".next-quietud/types/**/*.ts",
    ".next-rangos/types/**/*.ts",
    ".next-scroll/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-noche/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    // La app nativa tiene su propio tsconfig y sus propios tipos de React
    // Native. Compilarla con los de la web da errores que no significan nada.
    "movil"
  ]
}
